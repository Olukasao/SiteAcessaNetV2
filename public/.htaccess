# Hostinger (Apache): site React de página única.
# Endereços como /planos ou /contratos não existem como arquivo; o Apache
# entrega o index.html e o react-router mostra a página certa.
Options -MultiViews
RewriteEngine On

# Força HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Arquivos com hash no nome (assets/) nunca mudam: cache de 1 ano.
  <FilesMatch "^.*-[A-Za-z0-9_-]{8}\.(js|css|png|jpe?g|webp|avif|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html sempre atualizado, para cada deploy aparecer na hora.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
