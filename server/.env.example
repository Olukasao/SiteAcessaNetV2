# Copie para .env e preencha. Nunca commitar o .env real.

NODE_ENV=development
PORT=9531
# Origens autorizadas a chamar esta API (separadas por virgula). Vazio = qualquer origem (dev).
# Em producao (frontend e backend no mesmo dominio), recomendado preencher
# com a URL publica, ex: https://central.acessanet.com.br
CORS_ORIGINS=

# Diretorio do build do frontend servido estaticamente pelo proprio backend
# em producao. Opcional -- se vazio, usa "<cwd>/public" (irmao de "dist/").
STATIC_DIR=

# "sqlite" (default) ou "mysql". Com mysql, os campos MYSQL_* abaixo passam
# a ser obrigatorios e SQLITE_PATH e ignorado. Trocar exige so mudar esta
# variavel + reiniciar -- nenhum redeploy de codigo necessario (rollback
# instantaneo pra sqlite se algo der errado).
DB_DRIVER=sqlite

# Caminho do arquivo SQLite (autenticacao, sessao, avisos). So usado quando
# DB_DRIVER=sqlite. Mantenha FORA de qualquer pasta que seja apagada/recriada
# a cada deploy (ex: fora de dist/), senao os dados de clientes cadastrados
# se perdem a cada novo ZIP enviado.
SQLITE_PATH=./data/auth.sqlite

# So usado quando DB_DRIVER=mysql. Banco gerenciado pela hospedagem, fora da
# pasta que o deploy apaga/recria -- ver server/scripts/migrate-sqlite-to-mysql.mjs
# pra levar dados existentes do SQLite antes de trocar DB_DRIVER em producao.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Segredos PROPRIOS deste backend -- gerar novos, nao reaproveitar os do
# AcessaNet app (ex: openssl rand -hex 32). Minimo 32 caracteres: obrigatorio
# quando NODE_ENV=production (o processo nao sobe sem isso).
JWT_SECRET=
CPF_HASH_SECRET=
# HMAC do codigo OTP de recuperacao de senha (password_reset_requests.otp_hash).
# Segredo proprio, nunca reaproveitar CPF_HASH_SECRET/JWT_SECRET aqui.
OTP_HASH_SECRET=
# Secret separado do de cliente (JWT_SECRET) -- comprometer um token de
# cliente nunca deve permitir forjar um token admin. Tambem minimo 32
# caracteres, tambem obrigatorio em producao.
ADMIN_JWT_SECRET=

# TTLs de token (segundos). Opcionais -- se vazio, usa os defaults do
# config.ts (access: 900s/15min, refresh cliente: 30 dias, refresh admin: 7 dias).
ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_SECONDS=
ADMIN_ACCESS_TOKEN_TTL_SECONDS=
ADMIN_REFRESH_TOKEN_TTL_SECONDS=

# SMTP para e-mails transacionais (codigo de recuperacao de senha). Nunca usar
# para marketing/newsletter -- so seguranca/autenticacao, para preservar a
# reputacao do dominio remetente.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Integracao SGP (/api/ura/*: consulta cliente, ocorrencias). Mesma conta de
# integracao ja usada pela empresa -- reaproveitar o VALOR das credenciais
# reais, nunca uma dependencia de codigo/rede com outro repositorio.
SGP_BASE_URL=https://acessanet.sgp.net.br
SGP_APP=
SGP_TOKEN=
SGP_BASIC_USERNAME=
SGP_BASIC_PASSWORD=
SGP_TIMEOUT_MS=8000
# So "cpfcnpj" foi confirmado como campo de filtro valido em /api/ura/clientes/
# nesta instancia do SGP (testado 2026-09-26). Os outros nomes que aparecem em
# integracoes irmas (cpf_cnpj, cpfCnpj, cpf) NAO filtram nada aqui -- o SGP
# ignora o campo desconhecido e devolve a base inteira de clientes sem
# filtro (~20s, ~3MB, e o primeiro resultado seria de um cliente errado).
# So adicione outro campo a esta lista depois de confirmar que ele realmente
# filtra (testar direto contra /api/ura/clientes/ antes de configurar).
SGP_CPF_SEARCH_FIELDS=cpfcnpj

# Criacao real de chamado: POST /api/central/chamado/. Familia de API
# diferente de /api/ura/* -- autentica SO com token+app no corpo (nunca
# Basic Auth). CONFIRMADO (2026-09-28): a conta "ura" (SGP_APP/SGP_TOKEN,
# app=Noc) teve a permissao pra essa familia (/api/central/*) liberada --
# ate 2026-09-26 dava 403 "Credenciais de autenticacao incorretas", agora
# funciona com o MESMO valor de SGP_APP/SGP_TOKEN. Por isso o fallback
# abaixo pra SGP_APP/SGP_TOKEN funciona na pratica hoje; se voltar a falhar
# com 403, a permissao pode ter sido revogada de novo -- confirme no SGP em
# Sistema -> Ferramentas -> Painel Admin -> Tokens (API "Central Assinante").
SGP_CHAMADO_APP=
SGP_CHAMADO_TOKEN=
SGP_CHAMADO_TIMEOUT_MS=15000
# sem_os: comportamento NAO confirmado no SGP real. Deixe vazio ate validar
# num teste controlado -- quando vazio, o campo nem e enviado no payload.
SGP_CHAMADO_SEM_OS=
# Mapeia cada classificacao que a triagem pode produzir (ver
# supportCategories/evaluateDiagnosis em src/diagnosis/engine.ts) para o
# ocorrenciatipo/motivoos do SGP. Toda classificacao que pode abrir chamado
# precisa de uma entrada aqui, senao a abertura de chamado falha
# explicitamente para essa classificacao (nunca um id adivinhado).
#
# ATENCAO: o par ocorrenciaTipo=1063 ("SUPORTE N1") + motivoOs=6 ("REPARO"),
# usado ate 2026-09-26, foi validado so contra GET /api/os/ocorrencia/*/list/
# (que so confirma que o ID EXISTE no catalogo, nao que a combinacao tipo+
# motivo e aceita pelo POST /api/central/chamado/). Teste real em 2026-09-28
# contra o contrato de teste "3005 - TESTE SUPORTE" mostrou que esse par
# retorna {"msg":"Motivo de Ordem de Servico invalido"} -- NAO usar.
#
# Valores efetivamente CONFIRMADOS via chamado real criado com sucesso
# (2026-09-28, contrato 3005, protocolo 260928085200, ocorrencia_id 777637):
#   ocorrenciaTipo 10000 = "Suporte Tecnico" -- decisao do usuario: toda
#     classificacao cai no mesmo tipo, sem tipo separado por sintoma (o
#     detalhe do problema fica no "conteudo", ja com a transcricao completa
#     da triagem).
#   motivoOs 2125 = "URA - SUPORTE" -- unico motivo, entre os candidatos
#     testados (6/REPARO e 10000... ambos rejeitados p/ tipo=10000), que o
#     SGP aceitou pra essa combinacao; nao existe motivo especifico por fila.
# Nao existe tipo/motivo proprio de "troca de senha de wifi" no catalogo do
# SGP -- por isso TROCA_SENHA_ROTEADOR tambem cai no mesmo par.
SGP_CHAMADO_MAPPING={"FALHA_REDE_ACESSO":{"ocorrenciaTipo":"10000","motivoOs":"2125"},"WIFI_OU_REDE_LOCAL":{"ocorrenciaTipo":"10000","motivoOs":"2125"},"DIAGNOSTICO_INCONCLUSIVO":{"ocorrenciaTipo":"10000","motivoOs":"2125"},"LENTIDAO":{"ocorrenciaTipo":"10000","motivoOs":"2125"},"QUEDAS":{"ocorrenciaTipo":"10000","motivoOs":"2125"},"WIFI":{"ocorrenciaTipo":"10000","motivoOs":"2125"},"SITES_APPS":{"ocorrenciaTipo":"10000","motivoOs":"2125"},"EQUIPAMENTO":{"ocorrenciaTipo":"10000","motivoOs":"2125"},"TELEFONIA":{"ocorrenciaTipo":"10000","motivoOs":"2125"},"TROCA_SENHA_ROTEADOR":{"ocorrenciaTipo":"10000","motivoOs":"2125"},"OUTRO_PROBLEMA":{"ocorrenciaTipo":"10000","motivoOs":"2125"},"TRIAGEM_GERAL":{"ocorrenciaTipo":"10000","motivoOs":"2125"}}

# Assinaturas eletronicas (SGPSign). ENDPOINT AINDA NAO CONFIRMADO no SGP --
# nenhuma chamada real e feita hoje (ver server/src/integrations/sgp/providers.ts,
# SgpBackedSignatureProvider). SGP_SIGN_ENABLED fica false por padrao de
# proposito: quando o endpoint for confirmado e o metodo implementado em
# sgpClient.ts, so vira "enabled" quando alguem ligar esta chave explicitamente,
# nunca so porque SGP_APP/SGP_TOKEN (obrigatorios para login) existem.
SGP_SIGN_ENABLED=false
# Fallback para SGP_APP/SGP_TOKEN se vazios -- mesma logica do bloco CHAMADO
# acima, mas so passa a valer alguma coisa depois que SGP_SIGN_ENABLED=true.
SGP_SIGN_APP=
SGP_SIGN_TOKEN=
SGP_SIGN_TIMEOUT_MS=10000
# Dev-only: liga uma assinatura pendente FAKE pra construir/testar a tela de
# Assinaturas antes do endpoint real existir. Travado para false em
# producao no proprio config.ts, independente deste valor -- nunca deve
# aparecer para um cliente real.
SGP_SIGN_MOCK_ENABLED=false

# Integracao OLT Cloud (https://api.oltcloud.co/) -- SOMENTE LEITURA. Usada
# para detectar quedas coletivas (CTO/PON/OLT) e mostrar um aviso de
# instabilidade na Central do Assinante. Nunca reaproveitar este token em
# nenhum client que faca POST/PUT/PATCH/DELETE.
OLTCLOUD_BASE_URL=
OLTCLOUD_TOKEN=
# Timeout por chamada (5-10s recomendado pela OLT Cloud). Se estourar, a
# Central do Assinante continua funcionando e trata como "sem informacao".
OLTCLOUD_TIMEOUT_MS=8000
# TTL do cache de status de incidente por cliente -- evita 1 chamada a OLT
# Cloud por render da Central quando muitos clientes acessam ao mesmo tempo.
OLTCLOUD_CACHE_TTL_MS=45000
# GET /api/debug/oltcloud/client-status/:contractId -- rota SOMENTE PARA
# TESTE. Default: habilitada fora de producao, desabilitada em producao.
# Defina explicitamente "true"/"false" para sobrescrever o default.
OLTCLOUD_DEBUG_ENABLED=
# Se preenchido, a rota de debug exige o header "x-debug-token" com este
# valor. Recomendado preencher sempre que OLTCLOUD_DEBUG_ENABLED=true em um
# ambiente acessivel pela rede (nao so localhost).
OLTCLOUD_DEBUG_TOKEN=
# Usado so pelo script scripts/test-oltcloud.js (TESTE 4/5/6) -- contrato
# real para validar a integracao ponta a ponta. Pode tambem ser passado como
# argumento: node scripts/test-oltcloud.js <contractId>.
OLTCLOUD_TEST_CONTRACT_ID=

# Deteccao de instabilidade regional (server/src/services/networkIncidentDetection).
# Quantidade minima de dispositivos/clientes correlacionados pra virar
# confianca "high"/"confirmed" -- abaixo disso nunca vira incidente exposto
# ao cliente (evita falso positivo por 1-2 clientes oscilando).
REGIONAL_INCIDENT_MIN_CLIENTS=3
# Janela de tempo (minutos) pra considerar eventos da mesma infraestrutura
# como correlacionados.
REGIONAL_INCIDENT_WINDOW_MINUTES=10
# So usado se/quando existir fonte real de latitude/longitude no backend --
# hoje NAO existe (ver clientRegionResolver.ts), fica pronto e inerte.
REGIONAL_INCIDENT_RADIUS_METERS=800
# Depois de quanto tempo sem evidencia nova um incidente confirmado vira
# "resolved" (passa por "recovering" antes -- evita o aviso "aparece/some"
# com a rede oscilando).
REGIONAL_INCIDENT_RECOVERY_WINDOW_MINUTES=5
REGIONAL_INCIDENT_REFRESH_TTL_MS=45000
REGIONAL_INCIDENT_EQUIPMENT_PROBE_TTL_MS=45000
